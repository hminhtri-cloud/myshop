# Copy to .env before running. For an EXISTING MySQL volume, keep its credentials.
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_USER=myshop
MYSQL_PASSWORD=replace_with_local_app_password
MYSQL_DATABASE=myshop_db
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRE_MINUTES=30
